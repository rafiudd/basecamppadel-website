{
  "name": "basecamp-padel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file=.env.local scripts/db.mjs seed",
    "db:admin": "node --env-file=.env.local scripts/db.mjs admin",
    "db:setup": "node --env-file=.env.local scripts/db.mjs setup",
    "db:classes:seed": "node --env-file=.env scripts/seed-classes.mjs",
    "db:classes:clean": "node --env-file=.env scripts/seed-classes.mjs --clean",
    "photos:r2": "node --env-file=.env.local scripts/photos-to-r2.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "test:liga": "node --experimental-strip-types --env-file=.env scripts/test-liga-flow.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
