{
  "name": "basecamp-padel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env scripts/db.mjs indexes",
    "db:seed": "node --env-file=.env scripts/db.mjs status",
    "db:admin": "node --env-file=.env scripts/create-mongo-admin.mjs",
    "db:setup": "node --env-file=.env scripts/db.mjs setup",
    "db:classes:seed": "node --env-file=.env scripts/seed-classes.mjs",
    "db:classes:clean": "node --env-file=.env scripts/seed-classes.mjs --clean",
    "photos:r2": "node --env-file=.env scripts/photos-to-r2.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "test:liga": "node --experimental-strip-types --env-file=.env scripts/test-liga-flow.mjs",
    "db:mongo:migrate": "node --env-file=.env scripts/migrate-supabase-to-mongo.mjs",
    "db:mongo:migrate:dev": "node --env-file=.env scripts/migrate-supabase-to-mongo.mjs --target=dev",
    "db:mongo:migrate:prod": "node --env-file=.env scripts/migrate-supabase-to-mongo.mjs --target=prod --confirm-prod",
    "db:mongo:indexes": "node --env-file=.env scripts/optimize-mongo-indexes.mjs",
    "db:mongo:admin": "node --env-file=.env scripts/create-mongo-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.7.0",
    "next": "16.3.4",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
